# Roof Web Studio — Apache / Hostinger (LiteSpeed reads this too)
Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Uncomment once SSL is active (Hostinger > SSL). Pick www OR non-www and keep it.
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# 301 redirects: old URLs -> current pages (keeps links and rankings)
<IfModule mod_rewrite.c>
RewriteRule ^admin-panel/?$ /roofing-website-design/#admin-panel [NE,R=301,L]
</IfModule>
Redirect 301 /roofing-web-design-agency/ /roofing-website-design/
Redirect 301 /roofing-seo-agency/ /roofing-seo/
Redirect 301 /roofing-marketing-agency/ /roofing-google-ads/
Redirect 301 /roofing-websites/ /roofing-website-design/
Redirect 301 /blog/do-roofers-need-seo/ /blog/roofing-seo-guide/
Redirect 301 /free-audit/ /free-preview/
Redirect 301 /services/roofing-web-design/ /roofing-website-design/
Redirect 301 /services/roofing-seo/ /roofing-seo/
Redirect 301 /services/roofing-marketing/ /roofing-google-ads/
Redirect 301 /services/website-care-plans/ /pricing/
Redirect 301 /services/lead-response-automation/ /roofing-lead-generation/
Redirect 301 /services/reviews-reputation/ /local-seo-for-roofing-companies/
Redirect 301 /services/ /roofing-website-design/
Redirect 301 /locations/index.html /locations/san-antonio-tx/
Redirect 301 /resources/ /blog/
Redirect 301 /demos/ /our-work/

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(woff2|webp|jpg|png|svg)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml application/xml text/plain
</IfModule>

# Never serve these
<FilesMatch "^(manifest\.json|.*\.md|.*\.csv)$">
Require all denied
</FilesMatch>
