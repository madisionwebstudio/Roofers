# Roofrs — Apache / Hostinger (LiteSpeed reads this too)
Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Uncomment once SSL is active (Hostinger > SSL). Pick www OR non-www and keep it.
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Old v1 URLs -> new pages (keeps any links/rankings the old site earned)
Redirect 301 /free-audit/ /free-preview/
Redirect 301 /services/roofing-web-design/ /roofing-websites/
Redirect 301 /services/roofing-seo/ /roofing-seo/
Redirect 301 /services/roofing-marketing/ /roofing-google-ads/
Redirect 301 /services/website-care-plans/ /pricing/
Redirect 301 /services/lead-response-automation/ /roofing-websites/
Redirect 301 /services/reviews-reputation/ /roofing-seo/
Redirect 301 /services/ /roofing-websites/
Redirect 301 /locations/index.html /locations/san-antonio-tx/
Redirect 301 /resources/ /blog/

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(woff2|webp|jpg|png|svg)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml application/xml text/plain
</IfModule>

# Never serve these
<FilesMatch "^(manifest\.json|.*\.md|.*\.csv)$">
Require all denied
</FilesMatch>
